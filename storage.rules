rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin')
        || (firestore.exists(/databases/(default)/documents/user/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/user/$(request.auth.uid)).data.role == 'admin')
      );
    }

    match /paymentProofs/{appointmentId}/{fileName} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    match /serviceSubservices/{subserviceId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow delete: if isAdmin();
    }

    match /serviceSubservices/{legacyServiceId}/{legacySubserviceId} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }
  }
}
